<?xml version="1.0" encoding="UTF-8"?>
<!--
  review.xsd — XML Schema for local-review's review.xml export format.

  This schema documents the structure produced by src/cli/xml-serializer.ts.
  It is a reference artifact only — local-review does NOT perform runtime
  validation against this schema.

  Usage reference:
    <source type="branch">     requires: base
    <source type="pending">    requires: staged
    <source type="folder">     requires: path (absolute folder root)
    <source type="github-pr">  requires: owner, repo, pr;  optional: base (target branch)
    <source type="gitlab-mr">  requires: project, mr;     optional: base (target branch)
    <source type="agent">      optional: agent (name of the reviewing agent)
  Every type except folder also takes optional head (branch reviewed) and
  commit (SHA of HEAD), which the skill checks before open/apply.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- ===== Root ===== -->
  <xs:element name="review" type="ReviewType"/>

  <xs:complexType name="ReviewType">
    <xs:sequence>
      <xs:element name="timestamp" type="xs:string"/>
      <xs:element name="source"    type="SourceType"/>
      <xs:element name="files"     type="FilesType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== Source (polymorphic via 'type' attribute) ===== -->
  <!--
    When type="branch":    base is required.
    When type="pending":   staged is required.
    When type="folder":    path is required; head/commit are absent.
    When type="github-pr": owner, repo, pr are required; base is optional.
    When type="gitlab-mr": project, mr are required; base is optional.
    When type="agent":     agent is optional (name of the reviewing agent).
    Attributes of other types are absent.
  -->
  <xs:complexType name="SourceType">
    <xs:attribute name="type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="branch"/>
          <xs:enumeration value="pending"/>
          <xs:enumeration value="folder"/>
          <xs:enumeration value="github-pr"/>
          <xs:enumeration value="gitlab-mr"/>
          <xs:enumeration value="agent"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <!-- branch (compared base), github-pr / gitlab-mr (target branch) -->
    <xs:attribute name="base"   type="xs:string"/>
    <!-- pending -->
    <xs:attribute name="staged" type="xs:boolean"/>
    <!-- folder -->
    <xs:attribute name="path"   type="xs:string"/>
    <!-- github-pr -->
    <xs:attribute name="owner"  type="xs:string"/>
    <xs:attribute name="repo"   type="xs:string"/>
    <xs:attribute name="pr"     type="xs:positiveInteger"/>
    <!-- gitlab-mr -->
    <xs:attribute name="project" type="xs:string"/>
    <xs:attribute name="mr"      type="xs:positiveInteger"/>
    <!-- agent -->
    <xs:attribute name="agent"  type="xs:string"/>
    <!-- revision reviewed (all types except folder) -->
    <xs:attribute name="head"   type="xs:string"/>
    <xs:attribute name="commit">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9a-f]{40}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===== Files container ===== -->
  <xs:complexType name="FilesType">
    <xs:sequence>
      <xs:element name="file" type="FileType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== File ===== -->
  <!--
    path="src/foo.ts"  — repo-relative file path.
                         Special value "_discussion" holds PR/MR general
                         comments that could not be mapped to any file.
    viewed="false"     — whether the file has been marked as reviewed in the UI.
  -->
  <xs:complexType name="FileType">
    <xs:sequence>
      <xs:element name="comment" type="CommentType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="path"   type="xs:string"  use="required"/>
    <xs:attribute name="viewed" type="xs:boolean" use="required"/>
  </xs:complexType>

  <!-- ===== Comment ===== -->
  <xs:complexType name="CommentType">
    <xs:sequence>
      <!--
        <file> duplicates the parent <file path="..."> attribute.
        Present for self-contained comment serialization.
      -->
      <xs:element name="file"       type="xs:string"/>
      <!--
        <line> is omitted for file-level comments (line = null in ReviewComment).
        When present it is a self-closing element, e.g.:
          <line number="42" side="addition" />
        or, for a raw file line in a folder review (no side):
          <line number="42" />
      -->
      <xs:element name="line"       type="LineType" minOccurs="0"/>
      <xs:element name="body"       type="xs:string"/>
      <xs:element name="created-at" type="xs:string"/>
      <!--
        <url> is optional. Present for comments imported from a forge
        (GitHub/GitLab) to link back to the original comment.
      -->
      <xs:element name="url"        type="xs:anyURI" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <!-- edited is true when comment body was modified locally from imported content -->
    <xs:attribute name="edited" type="xs:boolean"/>
  </xs:complexType>

  <!-- ===== Line (self-closing) ===== -->
  <xs:complexType name="LineType">
    <xs:attribute name="number" type="xs:positiveInteger" use="required"/>
    <!-- Omitted for folder reviews, where number is a raw file line. -->
    <xs:attribute name="side">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="addition"/>
          <xs:enumeration value="deletion"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

</xs:schema>
