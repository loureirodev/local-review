{
  "name": "local-review",
  "version": "0.1.0",
  "description": "Lightweight web-based git diff review tool powered by @pierre/diffs",
  "type": "module",
  "bin": {
    "local-review": "./dist/cli/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "bun run --watch src/cli/index.ts -- --dev",
    "build": "vite build && bun build src/cli/index.ts --outdir dist/cli --target bun --external react --external react-dom --external @pierre/diffs",
    "preview": "bun run dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "code-review",
    "git",
    "diff",
    "developer-tools",
    "bun"
  ],
  "license": "MIT",
  "dependencies": {
    "@pierre/diffs": "^1.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/bun": "^1.2.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "@vitejs/plugin-react": "^4.4.1"
  }
}
