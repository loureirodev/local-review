{
  "name": "@loureirodev/local-review",
  "version": "0.3.1",
  "description": "Local code review UI that turns GitHub PRs, GitLab MRs, and local diffs into actionable review files for AI agents.",
  "type": "module",
  "bin": {
    "local-review": "./dist/cli/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "bun run --watch src/cli/index.ts -- --dev",
    "build": "vite build && bun build src/cli/index.ts --outdir dist/cli --target bun --external react --external react-dom --external @pierre/diffs --external @pierre/trees",
    "preview": "bun run dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix-files": "biome check --write",
    "format": "biome format --write .",
    "react-doctor": "react-doctor -y",
    "prepare": "husky",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "code-review",
    "git",
    "diff",
    "developer-tools",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/loureirodev/local-review.git"
  },
  "dependencies": {
    "@lexical/code": "^0.51.0",
    "@lexical/history": "^0.51.0",
    "@lexical/link": "^0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/markdown": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@lexical/selection": "^0.51.0",
    "@lexical/utils": "^0.51.0",
    "@pierre/diffs": "^1.3.6",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "lexical": "^0.51.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "react-doctor": "^0.1.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.1"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
